# ============================================================
# COMICCRAFT CONFIGURATION
# ============================================================

# Google Gemini
GEMINI_API_KEY=AQ.Ab8RN6 JNdXioGA50QKRsOMPd5CoQrx_r6UwLAKwOzJf-haDKmw

# Models can be changed without modifying Python code.
GEMINI_OUTLINE_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview


# ============================================================
# HUGGING FACE
# ============================================================

HF_API_KEY=your_huggingface_token_here

# Automatically select an available inference provider.
HF_PROVIDER=auto

# Image generation model.
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5


# ============================================================
# APPLICATION
# ============================================================

APP_NAME=ComicCraft
APP_ENV=development

# Set true to test the entire application without AI API calls.
MOCK_AI=false

# Number of comic panels.
PANEL_COUNT=5

# Image dimensions.
IMAGE_WIDTH=768
IMAGE_HEIGHT=768

# Stable Diffusion generation parameters.
IMAGE_STEPS=20
IMAGE_GUIDANCE=7.5